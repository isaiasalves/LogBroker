{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "Logs/log.txt" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },


  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "admin",
    "Password": "admin",
    "VirtualHost": "MyJira",
    "LogQueue": [
      {
        "Name": "MYJIRA.LOGGER.TRACE",
        "LogLevelQueueType": "Trace"
      },
      {
        "Name": "MYJIRA.LOGGER.ERROR",
        "LogLevelQueueType": "Error"
      }
    ]
  }
}
